# Copie para .env e preencha os segredos vazios — cada clone cria o seu; o .env não vai pro git.
# Fonte das credenciais de dev para o docker-compose e para os testes (README, seções Rodar localmente e Testes).

# DB
DB_HOST=db
DB_PORT=5432
DB_USER=app
DB_PASSWORD=
POSTGRES_PASSWORD=

# Broker
BROKER_HOST=broker
BROKER_PORT=5672
BROKER_PORT_WEB=15672
BROKER_USER=cueio
BROKER_PASSWORD=

# JWT — chave pública (todo -web que valida token de cliente final precisa dela).
# A chave PRIVADA fica só em .env.clientes (só o `clientes` assina).
JWT_PUBLIC_KEY=

# Sessão de compra web
SESSAO_COMPRA_WEB_HOST=sessaocompra-web
SESSAO_COMPRA_WEB_PORT=8080
SESSAO_COMPRA_WEB_DEBUG_PORT=9080
PAGAMENTO_INTERNO_ID=pagamentoInternoId
PAGAMENTO_INTERNO_SECRET=

# Clientes
CLIENTES_HOST=clientes
CLIENTES_PORT=8081
CLIENTES_DEBUG_PORT=9081

# Reservas externo hotel
RESERVAS_EXTERNO_HOTEL_HOST=reservas-externo-hotel
RESERVAS_EXTERNO_HOTEL_PORT=8082
RESERVAS_EXTERNO_HOTEL_DEBUG_PORT=9082
RESERVAS_EXTERNO_HOTEL_ID=reservasExternoHotelId
RESERVAS_EXTERNO_HOTEL_SECRET=

# Reservas externo voo
RESERVAS_EXTERNO_VOO_HOST=reservas-externo-voo
RESERVAS_EXTERNO_VOO_PORT=8083
RESERVAS_EXTERNO_VOO_DEBUG_PORT=9083
RESERVAS_EXTERNO_VOO_ID=reservasExternoVooId
RESERVAS_EXTERNO_VOO_SECRET=

# Reservas interno web hotel
RESERVAS_INTERNO_WEB_HOTEL_HOST=reservas-interno-hotel-web
RESERVAS_INTERNO_WEB_HOTEL_PORT=8084
RESERVAS_INTERNO_WEB_HOTEL_DEBUG_PORT=9084
RESERVAS_INTERNO_WEB_HOTEL_ID=reservasInternoHotelId
RESERVAS_INTERNO_WEB_HOTEL_SECRET=

# Reservas interno web voo
RESERVAS_INTERNO_WEB_VOO_HOST=reservas-interno-voo-web
RESERVAS_INTERNO_WEB_VOO_PORT=8085
RESERVAS_INTERNO_WEB_VOO_DEBUG_PORT=9085
RESERVAS_INTERNO_WEB_VOO_ID=reservasInternoVooId
RESERVAS_INTERNO_WEB_VOO_SECRET=

# Pagamento externo
PAGAMENTO_EXTERNO_HOST=pagamento-externo
PAGAMENTO_EXTERNO_PORT=8086
PAGAMENTO_EXTERNO_DEBUG_PORT=9086
PAGAMENTO_EXTERNO_ID=pagamentoExternoId
PAGAMENTO_EXTERNO_SECRET=

# Pagamento interno web
PAGAMENTO_INTERNO_HOST=pagamento-interno-web
PAGAMENTO_INTERNO_PORT=8087
PAGAMENTO_INTERNO_DEBUG_PORT=9087
SESSAO_COMPRA_ID=sessaoCompraId
SESSAO_COMPRA_SECRET=

# Debug (JDWP) dos papéis sem porta HTTP própria (sagas roda com o mesmo jar do -web,
# timeout roda com web-application-type: none) — numeração continua depois de 9087.
RESERVAS_INTERNO_HOTEL_SAGAS_DEBUG_PORT=9088
RESERVAS_INTERNO_VOO_SAGAS_DEBUG_PORT=9089
PAGAMENTO_INTERNO_SAGAS_DEBUG_PORT=9090
SESSAO_COMPRA_TIMEOUT_DEBUG_PORT=9091
PAGAMENTO_INTERNO_PENDENCIAS_DEBUG_PORT=9092
